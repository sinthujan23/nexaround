# NexAround Backend Environment Variables (TEMPLATE - DO NOT COMMIT REAL SECRETS)
SECRET_KEY=your_secure_random_64_char_hex_secret_key_here
POSTGRES_DB=nexaround_prod
POSTGRES_USER=nexaround_app
POSTGRES_PASSWORD=your_secure_postgres_password_here
DATABASE_URL=postgresql+asyncpg://nexaround_app:your_secure_postgres_password_here@db:5432/nexaround_prod

ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_portal_password_here

REDIS_URL=redis://redis:6379/0
FIREBASE_SERVICE_ACCOUNT_FILE=/etc/nexaround/firebase-sa.json

GOOGLE_API_KEY=your_google_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Email SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_smtp_app_password_here
EMAILS_FROM_EMAIL=noreply@nexaround.com

BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
