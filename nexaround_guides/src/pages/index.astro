---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import AppCta from '../components/AppCta.astro';
import HeroSlider from '../components/HeroSlider.astro';
import GuideBrowser from '../components/GuideBrowser.astro';
import WorldMap from '../components/WorldMap.astro';
import ExtremesChart from '../components/ExtremesChart.astro';
import AppShowcase from '../components/AppShowcase.astro';
import ComingUp from '../components/ComingUp.astro';
import { MAP_PLACES } from '../data/home';
import { UPCOMING } from '../data/upcoming';
import { getGuides } from '../lib/guides';
import { SITE } from '../site';
import heroImg from '../assets/guides/adelaide-to-perth-nullarbor/bunda-cliffs-2017-02.jpg';

const guides = await getGuides();
const countries = new Set(guides.flatMap((g) => g.data.country.replace(/.*\((.+)\)/, '$1').split(/ and /)).filter((c) => c !== 'Worldwide'));
const ids = new Set(guides.map((g) => g.id));
const continents = new Set(MAP_PLACES.filter((p) => p.guides.some((id) => ids.has(id))).map((p) => p.continent));
const latest = guides.reduce((d, g) => (g.data.lastChecked > d ? g.data.lastChecked : d), new Date(0));
const latestText = latest.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' });
const latestYear = latest.getUTCFullYear();

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: Astro.site?.href,
    description: SITE.description,
    publisher: { '@type': 'Organization', name: SITE.publisher, url: SITE.appSite },
  },
];
---
<Base title={SITE.name} image={heroImg} jsonLd={jsonLd}>
  <HeroSlider guides={guides}>
    {guides.length > 0 && (
    <div class="container" slot="stats">
      <div class="stats-card">
        <div class="stat"><strong data-count data-to={guides.length}>{guides.length}</strong><span>Guides, all measured</span></div>
        <div class="stat"><strong data-count data-to={countries.size}>{countries.size}</strong><span>Countries</span></div>
        <div class="stat"><strong data-count data-to={continents.size}>{continents.size}</strong><span>Continents</span></div>
        <div class="stat"><strong>{latestText}</strong><span>Latest check, {latestYear}</span></div>
      </div>
    </div>
    )}
  </HeroSlider>

  {guides.length > 0 ? (
    <GuideBrowser guides={guides} />
  ) : (
    <section class="section">
      <div class="container">
        <div class="section-head-row"><div><span class="badge badge-teal"><Icon name="book-open" /> In the works</span><h2>Being checked <span class="text-teal">right now</span></h2></div></div>
        <div class="guide-grid">
          {UPCOMING.map((u) => (
            <div class="card card-pad" style="display: flex; flex-direction: column; gap: 10px">
              <span class="eyebrow">In the works · {u.place}</span>
              <h3 style="font-size: 1.25rem">{u.title}</h3>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <ComingUp guides={guides} />

  <AppShowcase />

  {guides.length > 0 && <WorldMap guides={guides} />}
  {guides.length > 0 && <ExtremesChart guides={guides} />}

  <section class="section dark-section">
    <div class="container">
      <div class="section-head">
        <span class="badge badge-teal-glow"><Icon name="shield-check" /> How we work</span>
        <h2>Measured, sourced <span class="text-gradient-bright">and dated</span></h2>
        <p>Remote places punish bad information. A wrong fuel distance or an out-of-date permit rule can end a trip, so every guide is measured, sourced and dated.</p>
      </div>
      <div class="dark-grid">
        <div class="dark-card"><span class="dark-icon"><Icon name="route" /></span><h3>Measured routes</h3><p>Distances and driving times come from mapping data on the date we check the guide, not from memory.</p></div>
        <div class="dark-card"><span class="dark-icon"><Icon name="calendar-check" /></span><h3>Dated</h3><p>Every guide shows the day it was last checked, so you know how fresh it is.</p></div>
        <div class="dark-card"><span class="dark-icon"><Icon name="book-open" /></span><h3>Sourced</h3><p>Permits, fees and rules link to the official source, so you can check them yourself.</p></div>
        <div class="dark-card"><span class="dark-icon"><Icon name="camera" /></span><h3>Credited photos</h3><p>Photos come from photographers who have been there, used under free licences and credited by name.</p></div>
      </div>
      <p style="text-align: center; margin-top: 36px"><a class="link-arrow" style="color: var(--brand-cyan)" href="/editorial-policy/">Read our editorial policy <Icon name="arrow-right" /></a></p>
    </div>
  </section>

  <section class="section">
    <div class="container"><AppCta medium="home-footer" /></div>
  </section>
</Base>
