---
import GuidePage from '../../components/GuidePage.astro';
import { getGuides, getTranslations, type Guide, type Translation } from '../../lib/guides';

export async function getStaticPaths() {
  const guides = await getGuides();
  const translations = await getTranslations(guides);
  return guides.map((guide) => ({ params: { pillar: guide.data.pillar, slug: guide.id }, props: { guide, all: guides, translations } }));
}

interface Props { guide: Guide; all: Guide[]; translations: Map<string, Translation> }
const { guide, all, translations } = Astro.props;
---
<GuidePage guide={guide} all={all} lang="en" translations={translations} />
