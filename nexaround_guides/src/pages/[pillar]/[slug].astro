---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import GuideCard from '../../components/GuideCard.astro';
import RouteMap from '../../components/RouteMap.astro';
import LegTable from '../../components/LegTable.astro';
import StopList from '../../components/StopList.astro';
import Affiliate from '../../components/Affiliate.astro';
import AppCta from '../../components/AppCta.astro';
import StoreButtons from '../../components/StoreButtons.astro';
import { PILLARS, type PillarKey } from '../../data/pillars';
import { getGuides, guideUrl, readMinutes, formatDate, type Guide } from '../../lib/guides';
import { SITE } from '../../site';

export async function getStaticPaths() {
  const guides = await getGuides();
  return guides.map((guide) => ({ params: { pillar: guide.data.pillar, slug: guide.id }, props: { guide, all: guides } }));
}

interface Props { guide: Guide; all: Guide[] }
const { guide, all } = Astro.props;
const d = guide.data;
const pillar = PILLARS[d.pillar as PillarKey];
const { Content, headings } = await render(guide);
const toc = [
  ...headings.filter((h: { depth: number }) => h.depth === 2),
  ...(d.legs.length ? [{ slug: 'every-leg', text: 'Every leg' }] : []),
];

const routeLabel = `Map of the route: ${d.title}`;
const hasRoute = d.stops.length > 0 || d.routeLines.length > 0;
const related = [
  ...d.related.map((id: string) => all.find((g) => g.id === id)).filter(Boolean),
  ...all.filter((g) => g.id !== guide.id && g.data.pillar === d.pillar),
  ...all.filter((g) => g.id !== guide.id),
].filter((g, i, arr) => g && g.id !== guide.id && arr.findIndex((x) => x?.id === g.id) === i).slice(0, 3) as Guide[];

const url = new URL(guideUrl(guide), Astro.site).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: d.title,
    description: d.description,
    mainEntityOfPage: url,
    datePublished: (d.published ?? d.lastChecked).toISOString(),
    dateModified: d.lastChecked.toISOString(),
    author: { '@type': 'Organization', name: SITE.name, url: Astro.site?.href },
    publisher: { '@type': 'Organization', name: SITE.publisher, logo: { '@type': 'ImageObject', url: new URL('/logo_2.png', Astro.site).href } },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.href },
      { '@type': 'ListItem', position: 2, name: pillar.name, item: new URL(`/${d.pillar}/`, Astro.site).href },
      { '@type': 'ListItem', position: 3, name: d.title, item: url },
    ],
  },
];
---
<Base title={d.title} description={d.description} image={d.cover} type="article" jsonLd={jsonLd}>
  <section class="hero hero-guide">
    <div class="hero-bg">
      <Image src={d.cover} alt="" widths={[960, 1600, 2000]} sizes="100vw" loading="eager" fetchpriority="high" />
    </div>
    <div class="container hero-inner">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">›</span><a href={`/${d.pillar}/`}>{pillar.name}</a>
      </nav>
      <div class="hero-copy">
        <div style="display: flex; flex-wrap: wrap; gap: 10px">
          <span class="badge badge-teal-glow"><Icon name="map-pin" /> {pillar.name} · {d.country}</span>
          {d.draft && <span class="badge badge-gold" style="background: #ffb800; color: #0a1118">Draft · not yet edited</span>}
        </div>
        <h1 style="margin-top: 22px">{d.title}</h1>
        <p class="hero-lead">{d.description}</p>
        <div class="hero-meta">
          <span><Icon name="calendar-check" /> Checked {formatDate(d.lastChecked)}</span>
          <span><Icon name="clock" /> {readMinutes(guide)} min read</span>
          {d.region && <span><Icon name="map-pin" /> {d.region}</span>}
        </div>
      </div>
    </div>
    <p class="hero-credit">{d.coverAlt}. Photo: {d.coverCredit.author}, <a href={d.coverCredit.source}>{d.coverCredit.license}</a></p>
  </section>

  {d.facts.length > 0 && (
    <div class="container facts-strip">
      <div class="card facts-grid">
        {d.facts.map((f: { value: string; label: string }) => <div><strong>{f.value}</strong><span>{f.label}</span></div>)}
      </div>
    </div>
  )}
  <div class="container"><p class="credit-below">Cover: {d.coverAlt}. Photo: {d.coverCredit.author}, <a href={d.coverCredit.source}>{d.coverCredit.license}</a></p></div>

  <section class="section" style="padding-top: 72px">
    <div class="container guide-layout">
      <article>
        {d.draft && d.todo.length > 0 && (
          <div class="todo-box block">
            <h2>Before this guide is published, the team needs to:</h2>
            <ul>{d.todo.map((t: string) => <li>{t}</li>)}</ul>
          </div>
        )}

        {d.intro && (
          <div class="prose block">
            {d.intro.split(/\n\s*\n/).map((p: string) => <p>{p.trim()}</p>)}
          </div>
        )}

        {hasRoute && (
          <div class="block">
            <h2 class="block-title">The route at a glance</h2>
            <p class="block-sub">Tap a dot for details. Drag and zoom to explore.</p>
            <RouteMap route={d.route} lines={d.routeLines} stops={d.stops} label={routeLabel} />
          </div>
        )}

        <div class="prose block">
          <Content />
        </div>

        {d.legs.length > 0 && (
          <div class="block">
            <h2 class="block-title" id="every-leg">Every leg</h2>
            {d.legsNote && <p class="block-sub">{d.legsNote}</p>}
            <LegTable legs={d.legs} />
          </div>
        )}

        {d.stops.some((s: { kind: string }) => s.kind === 'free') && (
          <div class="block">
            <h2 class="block-title">Free stops on this route</h2>
            <p class="block-sub">Places that cost nothing to visit. Rules for staying overnight are in the guide above.</p>
            <StopList stops={d.stops.filter((s: { kind: string }) => s.kind === 'free')} />
          </div>
        )}

        {d.photos.length > 0 && (
          <div class="block">
            <h2 class="block-title">Along the way</h2>
            <div class="photo-grid">
              {d.photos.map((p: any) => (
                <figure>
                  <Image src={p.src} alt={p.alt} widths={[480, 800]} sizes="(max-width: 700px) 100vw, 420px" />
                  <figcaption>{p.caption ?? p.alt}. Photo: {p.credit.author}, <a href={p.credit.source}>{p.credit.license}</a></figcaption>
                </figure>
              ))}
            </div>
          </div>
        )}

        {d.affiliates.length > 0 && (
          <div class="block" style="display: flex; flex-direction: column; gap: 14px">
            {d.affiliates.map((a: { program: 'airalo' | 'gettransfer'; country?: string }) => <Affiliate program={a.program} country={a.country} />)}
          </div>
        )}

        {d.sources.length > 0 && (
          <div class="block sources">
            <h2 class="block-title">Sources</h2>
            <ol>{d.sources.map((s: { title: string; url: string }) => <li><a href={s.url} rel="noopener">{s.title}</a></li>)}</ol>
          </div>
        )}

        <div class="block checked-note">
          <Icon name="calendar-check" />
          <p>We last checked this guide on <strong>{formatDate(d.lastChecked)}</strong>. Roads, fees and rules change. If something is out of date, tell us at <a href={`mailto:${SITE.email}`} style="color: var(--brand-teal); text-decoration: underline">{SITE.email}</a>.</p>
        </div>
      </article>

      <aside class="guide-aside" aria-label="On this page">
        {toc.length > 1 && (
          <nav class="card toc" aria-label="Contents">
            <h2>On this page</h2>
            <ol>{toc.map((h: { slug: string; text: string }) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
          </nav>
        )}
        <div class="card aside-app">
          <span class="badge badge-teal-glow"><Icon name="sparkle" /> Odyssey planner</span>
          <h2>Turn this guide into your trip</h2>
          <p>The nexARound app builds a day-by-day plan with stops, stays and costs for your dates.</p>
          <StoreButtons onDark />
        </div>
      </aside>
    </div>
  </section>

  {related.length > 0 && (
    <section class="section section-light">
      <div class="container">
        <div class="section-head-row"><div><span class="badge badge-teal"><Icon name="compass" /> Keep exploring</span><h2>More guides</h2></div></div>
        <div class="guide-grid">{related.map((g) => <GuideCard guide={g} />)}</div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container"><AppCta /></div>
  </section>
</Base>
