---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import GuideCard from '../../components/GuideCard.astro';
import AppCta from '../../components/AppCta.astro';
import { PILLARS, PILLAR_KEYS, type PillarKey } from '../../data/pillars';
import { getGuides } from '../../lib/guides';

export function getStaticPaths() {
  return PILLAR_KEYS.map((pillar) => ({ params: { pillar } }));
}

const key = Astro.params.pillar as PillarKey;
const pillar = PILLARS[key];
const guides = (await getGuides()).filter((g) => g.data.pillar === key);
const others = PILLAR_KEYS.filter((k) => k !== key);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.href },
      { '@type': 'ListItem', position: 2, name: pillar.name, item: new URL(`/${key}/`, Astro.site).href },
    ],
  },
];
---
<Base title={pillar.name} description={pillar.intro} jsonLd={jsonLd}>
  <section class="hero hero-page">
    <div class="container hero-inner">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">›</span><span aria-current="page">{pillar.name}</span></nav>
      <div class="hero-copy">
        <span class="badge badge-teal-glow"><Icon name="compass" /> {pillar.short}</span>
        <h1 style="margin-top: 20px">{pillar.name}</h1>
        <p class="hero-lead">{pillar.intro}</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {guides.length > 0 ? (
        <div class="guide-grid">{guides.map((g, i) => <GuideCard guide={g} eager={i < 3} />)}</div>
      ) : (
        <div class="card card-pad" style="max-width: 760px">
          <span class="eyebrow">Coming soon</span>
          <h2 style="font-size: 1.6rem; margin-top: 10px">The first guides in this section are being checked</h2>
          <p style="color: var(--text-secondary); margin-top: 10px">We publish a guide only after its distances, costs and rules have been checked. Meanwhile, try another kind of trip:</p>
          <div style="display: flex; flex-wrap: wrap; gap: 10px; margin-top: 20px">
            {others.map((k) => <a class="btn btn-secondary" href={`/${k}/`}>{PILLARS[k].name}</a>)}
          </div>
        </div>
      )}
    </div>
  </section>

  <section class="section" style="padding-top: 0">
    <div class="container"><AppCta medium="section-footer" campaign={key} /></div>
  </section>
</Base>
