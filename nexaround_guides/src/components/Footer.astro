---
import Icon from './Icon.astro';
import StoreButtons from './StoreButtons.astro';
import { PILLARS, PILLAR_KEYS } from '../data/pillars';
import { SITE } from '../site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="brand" aria-label={`${SITE.name}, home`}>
          <span class="brand-logo"><img src="/logo_2.png" alt="" width="30" height="30" /></span>
          <span class="brand-title">nexARound <span style="font-weight: 300">Guides</span></span>
        </a>
        <p>Guides to remote and unusual places: measured, sourced and dated. Plan any of these trips day by day with Odyssey in the nexARound app.</p>
        <StoreButtons onDark />
      </div>
      <div class="footer-col">
        <h2>Guides</h2>
        <ul>
          {PILLAR_KEYS.map((k) => <li><a href={`/${k}/`}>{PILLARS[k].name}</a></li>)}
        </ul>
      </div>
      <div class="footer-col">
        <h2>About</h2>
        <ul>
          <li><a href="/about/">About us</a></li>
          <li><a href="/editorial-policy/">Editorial policy</a></li>
          <li><a href="/affiliate-disclosure/">Affiliate disclosure</a></li>
          <li><a href="/privacy/">Privacy</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h2>Connect</h2>
        <ul>
          <li><a href={`mailto:${SITE.email}`}><span class="footer-icon"><Icon name="mail" /></span>{SITE.email}</a></li>
          <li><a href={SITE.appSite}><span class="footer-icon"><Icon name="globe" /></span>app.nexaround.com</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {year} {SITE.publisher}. Some links earn us a commission at no cost to you.</span>
      <nav aria-label="Legal">
        <a href="/privacy/">Privacy</a>
        <a href="/affiliate-disclosure/">Affiliate disclosure</a>
        <a href="/contact/">Contact</a>
      </nav>
    </div>
  </div>
</footer>
