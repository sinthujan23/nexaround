---
import Icon from './Icon.astro';
import StoreButtons from './StoreButtons.astro';
import { PILLARS, PILLAR_KEYS } from '../data/pillars';
import { SITE } from '../site';
import { ui, fill, type Lang } from '../lib/i18n';
interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const t = ui(lang);
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="brand" aria-label={`${SITE.name}, home`}>
          <span class="brand-logo"><img src="/logo_2.png" alt="" width="30" height="30" /></span>
          <span class="brand-title">nexARound <span style="font-weight: 300">Guides</span></span>
        </a>
        <p>{t.fBlurb}</p>
        <StoreButtons onDark medium="footer" lang={lang} />
      </div>
      <div class="footer-col">
        <h2>{t.fGuides}</h2>
        <ul>
          {PILLAR_KEYS.map((k) => <li><a href={`/${k}/`}>{t.pillars[k] ?? PILLARS[k].name}</a></li>)}
        </ul>
      </div>
      <div class="footer-col">
        <h2>{t.fAbout}</h2>
        <ul>
          <li><a href="/about/">{t.fAboutUs}</a></li>
          <li><a href="/editorial-policy/">{t.fEditorial}</a></li>
          <li><a href="/affiliate-disclosure/">{t.fAffiliate}</a></li>
          <li><a href="/privacy/">{t.fPrivacy}</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h2>{t.fConnect}</h2>
        <ul>
          <li><a href={`mailto:${SITE.email}`}><span class="footer-icon"><Icon name="mail" /></span>{SITE.email}</a></li>
          <li><a href={SITE.appSite}><span class="footer-icon"><Icon name="globe" /></span>app.nexaround.com</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>{fill(t.fRights, { year })}</span>
      <nav aria-label="Legal">
        <a href="/privacy/">{t.fPrivacy}</a>
        <a href="/affiliate-disclosure/">{t.fAffiliate}</a>
        <a href="/contact/">{t.fContact}</a>
      </nav>
    </div>
  </div>
</footer>
