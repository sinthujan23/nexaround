---
// Interactive route map: Leaflet over OpenStreetMap tiles. Route lines come
// from src/data/routes/<route>.json (simplified Google Directions polylines);
// stops come from the guide's frontmatter. Loads only when scrolled near.
interface Stop { name: string; lat: number; lng: number; kind: string; note?: string }
interface Line { key: string; label: string; dashed: boolean }
interface Props { route?: string; lines: Line[]; stops: Stop[]; label: string }

const { route, lines, stops, label } = Astro.props;
const routeFiles = import.meta.glob<{ default: Record<string, [number, number][]> }>('../data/routes/*.json', { eager: true });
const data = route ? routeFiles[`../data/routes/${route}.json`]?.default ?? {} : {};
const payload = {
  lines: lines.map((l) => ({ ...l, points: data[l.key] ?? [] })).filter((l) => l.points.length),
  stops,
};
const kinds = new Set(stops.map((s) => s.kind));
---
<figure class="card map-card" style="margin: 0">
  <div class="route-map" role="region" aria-label={label} data-route-map={JSON.stringify(payload)}></div>
  <figcaption class="map-legend">
    {payload.lines.map((l) => (
      <span><i class={l.dashed ? 'swatch-dash' : 'swatch-line'}></i>{l.label}</span>
    ))}
    {kinds.has('town') && <span><i class="swatch-dot" style="background: #007a7c"></i>Town</span>}
    {kinds.has('fuel') && <span><i class="swatch-dot" style="background: #00a5a8"></i>Roadhouse (fuel)</span>}
    {kinds.has('free') && <span><i class="swatch-dot" style="background: #ffb800"></i>Free stop</span>}
    {kinds.has('paid') && <span><i class="swatch-dot" style="background: #64748b"></i>Paid entry</span>}
    <span style="margin-left: auto">Map data © <a href="https://www.openstreetmap.org/copyright" style="text-decoration: underline">OpenStreetMap</a> contributors</span>
  </figcaption>
</figure>

<script>
  import 'leaflet/dist/leaflet.css';

  const COLORS: Record<string, string> = { town: '#007a7c', fuel: '#00a5a8', free: '#ffb800', paid: '#64748b' };

  async function draw(el: HTMLElement) {
    const L = (await import('leaflet')).default;
    const { lines, stops } = JSON.parse(el.dataset.routeMap || '{}');
    const map = L.map(el, { scrollWheelZoom: false, attributionControl: false });
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 17 }).addTo(map);

    const bounds = L.latLngBounds([]);
    for (const line of lines) {
      const pl = L.polyline(line.points, {
        color: line.dashed ? '#8a5a00' : '#007a7c',
        weight: line.dashed ? 3 : 5,
        opacity: 0.95,
        dashArray: line.dashed ? '8 8' : undefined,
      }).addTo(map);
      bounds.extend(pl.getBounds());
    }
    for (const s of stops) {
      const free = s.kind === 'free';
      const m = L.circleMarker([s.lat, s.lng], {
        radius: free ? 8 : s.kind === 'town' ? 7 : 6,
        color: free ? '#0a1118' : '#ffffff',
        weight: 2,
        fillColor: COLORS[s.kind] ?? COLORS.town,
        fillOpacity: 1,
      }).addTo(map);
      const box = document.createElement('div');
      box.className = 'map-popup';
      const name = document.createElement('strong');
      name.textContent = s.name;
      box.append(name);
      if (s.note) {
        const note = document.createElement('span');
        note.textContent = s.note;
        box.append(note);
      }
      m.bindPopup(box);
      bounds.extend([s.lat, s.lng]);
    }
    if (bounds.isValid()) map.fitBounds(bounds, { padding: [24, 24] });
  }

  const els = document.querySelectorAll<HTMLElement>('[data-route-map]');
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (e.isIntersecting) {
        io.unobserve(e.target);
        draw(e.target as HTMLElement);
      }
    }
  }, { rootMargin: '300px' });
  els.forEach((el) => io.observe(el));
</script>
